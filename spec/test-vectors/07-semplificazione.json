{
  "name": "La semplificazione elimina un passaggio",
  "description": "Anna paga 10 € per Luca, Luca paga 10 € per Sara. Per coppia servono due trasferimenti; semplificando basta che Sara dia 10 € ad Anna.",
  "input": {
    "expenses": [
      {
        "id": "e_1",
        "total": { "minor": 1000, "currency": "EUR" },
        "paidBy": [{ "memberId": "m_a", "amount": { "minor": 1000, "currency": "EUR" } }],
        "split": { "method": "equal", "memberIds": ["m_b"] }
      },
      {
        "id": "e_2",
        "total": { "minor": 1000, "currency": "EUR" },
        "paidBy": [{ "memberId": "m_b", "amount": { "minor": 1000, "currency": "EUR" } }],
        "split": { "method": "equal", "memberIds": ["m_c"] }
      }
    ],
    "settlements": []
  },
  "expected": {
    "owed": {
      "e_1": { "m_b": 1000 },
      "e_2": { "m_c": 1000 }
    },
    "balances": { "EUR": { "m_a": 1000, "m_b": 0, "m_c": -1000 } },
    "simplifiedTransfers": [
      { "from": "m_c", "to": "m_a", "amount": { "minor": 1000, "currency": "EUR" } }
    ],
    "pairwiseTransfers": [
      { "from": "m_b", "to": "m_a", "amount": { "minor": 1000, "currency": "EUR" } },
      { "from": "m_c", "to": "m_b", "amount": { "minor": 1000, "currency": "EUR" } }
    ]
  }
}
