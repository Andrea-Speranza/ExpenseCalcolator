{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Spese di gruppo",
  "mainBinaryName": "expense-calcolator",
  "version": "0.1.0",
  "identifier": "io.github.andreasperanza.expensecalcolator",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter @expense/web dev",
    "beforeBuildCommand": "pnpm --filter @expense/web build"
  },
  "app": {
    "windows": [
      {
        "title": "Spese di gruppo",
        "width": 1000,
        "height": 760,
        "minWidth": 360,
        "minHeight": 500,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; font-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
