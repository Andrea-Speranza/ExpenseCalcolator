{
  "name": "expense-calcolator",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm release:check && pnpm deps && pnpm coverage && pnpm web:build && pnpm demo:build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.json",
    "deps": "depcruise packages apps --config .dependency-cruiser.mjs && node scripts/deps-graph.mjs --check",
    "deps:graph": "node scripts/deps-graph.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "cli": "pnpm --silent --filter @expense/cli build && node apps/cli/dist/spese.mjs",
    "web": "pnpm --filter @expense/web dev",
    "web:build": "pnpm --filter @expense/web build",
    "web:preview": "pnpm --filter @expense/web build && pnpm --filter @expense/web preview",
    "e2e": "pnpm --filter @expense/web e2e",
    "demo": "pnpm --filter @expense/demo dev",
    "demo:build": "pnpm --filter @expense/demo build",
    "demo:preview": "pnpm --filter @expense/demo build && pnpm --filter @expense/demo preview",
    "native": "pnpm --filter @expense/native dev",
    "native:build": "pnpm --filter @expense/native build",
    "native:check": "pnpm --filter @expense/native check",
    "schemas": "node scripts/update-json-schemas.mjs",
    "release": "node scripts/release.mjs",
    "release:check": "node scripts/release.mjs --check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.1.1",
    "@eslint/markdown": "^8.0.3",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.4",
    "@vitest/eslint-plugin": "^1.6.27",
    "dependency-cruiser": "^18.6.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fast-check": "^4.10.2",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.4"
  }
}
